@mode(host.dual)

from debug.assert import (expect, expectEq);
from cli.args import (parse_args);
from commands.head import (head_lines, bytes_kept, header, show_headers, quote_name, io_reason);

func test_first_lines(): void {
    expectEq(head_lines("1\n2\n3\n", 2, false, "\n"), "1\n2\n", "two of three");
    expectEq(head_lines("1\n2\n3\n", 5, false, "\n"), "1\n2\n3\n", "more than there are");
    expectEq(head_lines("1\n2\n3", 3, false, "\n"), "1\n2\n3", "last line without newline");
    expectEq(head_lines("1\n2\n3", 0, false, "\n"), "", "zero");
    expectEq(head_lines("", 10, false, "\n"), "", "empty");
    expectEq(head_lines("\n\n\n", 2, false, "\n"), "\n\n", "empty lines");
}

func test_all_but_last_lines(): void {
    expectEq(head_lines("1\n2\n3\n", 1, true, "\n"), "1\n2\n", "drop one");
    expectEq(head_lines("1\n2\n3", 1, true, "\n"), "1\n2\n", "partial last line counts");
    expectEq(head_lines("1\n2\n3\n", 0, true, "\n"), "1\n2\n3\n", "drop none");
    expectEq(head_lines("1\n2\n3\n", 9, true, "\n"), "", "drop all");
}

func test_nul_delimiter(): void {
    let nul = str(char.of(0));
    expectEq(head_lines("a" + nul + "b" + nul + "c", 2, false, nul), "a" + nul + "b" + nul, "-z");
    expectEq(head_lines("a\nb" + nul + "c", 1, false, nul), "a\nb" + nul, "newlines are data under -z");
}

func test_bytes_kept(): void {
    expectEq(bytes_kept(10, 3, false), 3, "first 3");
    expectEq(bytes_kept(10, 30, false), 10, "all");
    expectEq(bytes_kept(10, 3, true), 7, "all but 3");
    expectEq(bytes_kept(10, 30, true), 0, "none");
}

func test_headers(): void {
    expectEq(header("a", true), "==> a <==\n", "first");
    expectEq(header("b", false), "\n==> b <==\n", "later");
    let auto = parse_args(["x"]).unwrap();
    expect(!show_headers(auto, 1) and show_headers(auto, 2), "auto");
    expect(show_headers(parse_args(["-v"]).unwrap(), 1), "-v");
    expect(!show_headers(parse_args(["-q"]).unwrap(), 3), "-q");
}

func test_quote_name(): void {
    expectEq(quote_name("a b"), "'a b'", "single quotes");
    expectEq(quote_name("it's"), "\"it's\"", "double quotes around a quote");
    expectEq(quote_name("it's $x"), "'it'\\''s $x'", "escaped quote");
}

func test_io_reason(): void {
    expectEq(io_reason("read_text failed on 'x': Permission denied (os error 13)"), "Permission denied", "reason");
}
