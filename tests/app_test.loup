@mode(host.dual)

# Exit statuses of the whole command line. These tests print the program's
# normal output.

from debug.assert import (expectEq);
from appinfo import (EXIT_OK, EXIT_FAILURE, EXIT_USAGE);
from cli.app import (run);

func test_version_succeeds(): void {
    expectEq(run(["--version"]), EXIT_OK, "--version");
}

func test_help_succeeds(): void {
    expectEq(run(["--help"]), EXIT_OK, "--help");
}

func test_lines_and_bytes_succeed(): void {
    expectEq(run(["-n", "2", "tests/fixtures/twelve.txt"]), EXIT_OK, "-n 2");
    expectEq(run(["-c", "-20", "tests/fixtures/twelve.txt"]), EXIT_OK, "-c -20");
}

func test_missing_file_fails(): void {
    expectEq(run(["tests/fixtures/missing.txt", "tests/fixtures/twelve.txt"]), EXIT_FAILURE, "missing");
}

func test_directory_fails(): void {
    expectEq(run(["tests/fixtures"]), EXIT_FAILURE, "directory");
}

func test_usage_errors(): void {
    expectEq(run(["-x"]), EXIT_USAGE, "invalid option");
    expectEq(run(["-n", "x"]), EXIT_USAGE, "invalid number");
    expectEq(EXIT_USAGE, 1, "GNU head uses 1");
}
