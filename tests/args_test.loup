@mode(host.dual)

# Unit tests for head's argument parsing (cli.args): defaults, -n/-c
# values, option clusters, -q/-v, the obsolete `-5c` form, long option
# prefixes and the usage error messages.
#
# Runtime: host.dual, run by the test runner: `make test` interprets this
# file with Stage0 (`loup-bootstrap test`, source/ on LOUPPATH), one test
# per `func test_*()`. It is not part of the binary.

from debug.assert import (expect, expectEq);
from cli.args import (
    parse_args, is_obsolete_count, match_long, long_names,
    HEADERS_AUTO, HEADERS_NEVER, HEADERS_ALWAYS,
);

func test_defaults(): void {
    let none: list[string] = [];
    let opts = parse_args(none).unwrap();
    expectEq(opts.count, 10, "ten lines");
    expect(!opts.count_bytes and !opts.elide and !opts.zero, "lines, from the start");
    expectEq(opts.headers, HEADERS_AUTO, "headers when several files");
    expectEq(opts.operands.len(), 0, "no operands");
}

func test_count_options(): void {
    let lines = parse_args(["-n", "3", "f"]).unwrap();
    expect(lines.count == 3 and !lines.count_bytes, "-n 3");
    expectEq(lines.operands[0], "f", "operand");
    let bytes = parse_args(["-c5"]).unwrap();
    expect(bytes.count == 5 and bytes.count_bytes, "-c5");
    let elide = parse_args(["--lines=-2"]).unwrap();
    expect(elide.count == 2 and elide.elide, "--lines=-2");
    let last = parse_args(["-n", "2", "-c", "7"]).unwrap();
    expect(last.count == 7 and last.count_bytes, "the last count wins");
}

func test_clusters(): void {
    let opts = parse_args(["-qzn4"]).unwrap();
    expect(opts.headers == HEADERS_NEVER and opts.zero and opts.count == 4, "-qzn4");
    expectEq(parse_args(["-nq"]).unwrap_err().message, "invalid number of lines: 'q'", "-nq takes q as the count");
}

func test_headers_last_wins(): void {
    expectEq(parse_args(["-q", "-v"]).unwrap().headers, HEADERS_ALWAYS, "-q -v");
    expectEq(parse_args(["--verbose", "--silent"]).unwrap().headers, HEADERS_NEVER, "--verbose --silent");
}

func test_obsolete_count(): void {
    expect(is_obsolete_count("-5"), "-5");
    expect(!is_obsolete_count("-n"), "-n");
    expect(!is_obsolete_count("-"), "-");
    let five = parse_args(["-5", "f"]).unwrap();
    expect(five.count == 5 and !five.count_bytes, "-5");
    let bytes = parse_args(["-5c"]).unwrap();
    expect(bytes.count == 5 and bytes.count_bytes, "-5c");
    let kilo = parse_args(["-2kqv"]).unwrap();
    expect(kilo.count == 2048 and kilo.count_bytes and kilo.headers == HEADERS_ALWAYS, "-2kqv");
    expectEq(parse_args(["-3x"]).unwrap_err().message, "invalid trailing option -- x", "bad letter");
    expectEq(parse_args(["-n", "1", "-5"]).unwrap_err().message, "invalid trailing option -- 5", "not first");
}

func test_operands_and_double_dash(): void {
    let opts = parse_args(["a", "-n", "1", "-", "--", "-v"]).unwrap();
    expectEq(opts.count, 1, "option after an operand");
    expectEq(opts.operands.len(), 3, "a, -, -v");
    expectEq(opts.operands[2], "-v", "-v after -- is an operand");
    expectEq(opts.headers, HEADERS_AUTO, "not verbose");
}

func test_long_names(): void {
    expectEq(match_long("q", "--q", long_names()).unwrap(), "quiet", "prefix");
    expectEq(
        match_long("v", "--v", long_names()).unwrap_err(),
        "option '--v' is ambiguous; possibilities: '--verbose' '--version'",
        "ambiguous",
    );
}

func test_usage_errors(): void {
    let missing = parse_args(["-n"]).unwrap_err();
    expectEq(missing.message, "option requires an argument -- 'n'", "short");
    expect(missing.try_help, "with the Try line");
    expectEq(parse_args(["--lines"]).unwrap_err().message, "option '--lines' requires an argument", "long");
    expectEq(parse_args(["--quiet=1"]).unwrap_err().message, "option '--quiet' doesn't allow an argument", "argument");
    expectEq(parse_args(["-x"]).unwrap_err().message, "invalid option -- 'x'", "unknown");
    let number = parse_args(["-c", "x"]).unwrap_err();
    expectEq(number.message, "invalid number of bytes: 'x'", "bad number");
    expect(!number.try_help, "no Try line for numbers");
}

func test_help_stops_parsing(): void {
    expect(parse_args(["--help", "-x"]).unwrap().help, "--help first");
    expect(parse_args(["--vers"]).unwrap().version, "--vers");
}
