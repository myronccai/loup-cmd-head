@mode(host.dual)

# Application identity. Keep APP_NAME and APP_VERSION in step with `name`
# and `version` in package.lppkg.

pub const APP_NAME: string = "head";
pub const APP_VERSION: string = "0.1.0";
pub const APP_SUMMARY: string = "Print the first part of files (a Loup recreation of GNU head).";

# Exit statuses returned by main(). GNU head reports usage errors with
# status 1, the same as a missing file.
pub const EXIT_OK: int = 0;
pub const EXIT_FAILURE: int = 1;
pub const EXIT_USAGE: int = 1;
