@mode(host.dual)

# Command-line parsing for head, following GNU getopt_long: short options
# may be combined (`-qn5`), and `-n`/`-c` take the rest of their group or
# the next argument as their value; options and operands may be mixed; `--`
# ends the options; a lone `-` is an operand (standard input); a long option
# may be abbreviated to any unique prefix (`--li=5`). Before all that, GNU
# head accepts an obsolete count as the first argument: `-5`, `-5c`, `-2kq`.
#
# Runtime: host.dual. Compiled into the native binary build/head by `make
# build`; `loup run source/main.loup` interprets the same code.
#
# Structure: parse_args makes two passes over the front of argv: first the
# obsolete count, which only the first argument may be, then the getopt
# loop over the rest. Counts are parsed by cli.count.

from cli.count import (parse_count);

pub const HEADERS_AUTO: int = 0;
pub const HEADERS_NEVER: int = 1;
pub const HEADERS_ALWAYS: int = 2;

pub struct Options {
    pub help: bool;
    pub version: bool;
    pub count: int;
    pub count_bytes: bool;
    pub elide: bool;
    pub headers: int;
    pub zero: bool;
    pub operands: list[string];
}

# A command line head cannot run: GNU's message, and whether to follow it
# with the "Try 'head --help'" line (bad numbers do not get one).
#
# A class implementing From[string], so that `?` on a Result[_, string]
# turns the error into a UsageError. The only such errors here are cli.count's
# messages about bad numbers, so `from` gives them no Try line.
pub class UsageError implements From[string] {
    pub let message: string;
    pub let try_help: bool;

    new(message: string, try_help: bool) {
        this.message = message;
        this.try_help = try_help;
    }

    pub static func from(message: string): UsageError {
        return UsageError(message, false);
    }
}

# head's long options, in GNU's order (the order of an ambiguity message).
pub func long_names(): list[string] {
    return ["bytes", "lines", "quiet", "silent", "verbose", "zero-terminated", "help", "version"];
}

# Resolves the name of a long option (`given`, without `--` or `=VALUE`)
# against `names` as getopt_long does: an exact name wins, otherwise the
# name must be the prefix of exactly one option. `arg` is the argument as
# typed, for the error message.
pub func match_long(given: string, arg: string, names: list[string]): Result[string, string] {
    var found: list[string] = [];
    for (name in names) {
        if (name == given) {
            return Ok(name);
        }
        if (name.startsWith(given)) {
            found.push(name);
        }
    }
    if (found.len() == 1) {
        return Ok(found[0]);
    }
    if (found.len() == 0) {
        return Err(i"unrecognized option '{$ arg $}'");
    }
    var listed: list[string] = [];
    for (name in found) {
        listed.push(i"'--{$ name $}'");
    }
    return Err(i"option '{$ arg $}' is ambiguous; possibilities: {$ listed.join(" ") $}");
}

func usage_error(message: string): UsageError {
    return UsageError(message, true);
}

func is_digit(ch: string): bool {
    return ch.len() == 1 and "0123456789".index_of(ch) >= 0;
}

# Whether `arg` is GNU head's obsolete count option: a dash and a digit.
pub func is_obsolete_count(arg: string): bool {
    return arg.len() >= 2 and arg.startsWith("-") and is_digit(arg.slice(1, 2));
}

pub func parse_args(argv: list[string]): Result[Options, UsageError] {
    var help = false;
    var version = false;
    var count = 10;
    var count_bytes = false;
    var elide = false;
    var headers = HEADERS_AUTO;
    var zero = false;
    var operands: list[string] = [];
    var only_operands = false;
    var i = 0;

    # Pass 1, the obsolete count (`-5`, `-5c`, `-2kq`): digits, then letters
    # that pick lines (l) or bytes (c, or b/k/m as a multiplier) or set
    # q, v and z. GNU only looks for it in the first argument.
    if (argv.len() > 0 and is_obsolete_count(argv[0])) {
        var chars: list[string] = [];
        for (ch in argv[0].slice(1)) {
            chars.push(ch);
        }
        var number = "";
        var k = 0;
        while (k < chars.len() and is_digit(chars[k])) {
            number += chars[k];
            k += 1;
        }
        var lines = true;
        var multiplier = "";
        while (k < chars.len()) {
            let letter = chars[k];
            if (letter == "c") {
                lines = false;
                multiplier = "";
            } else if (letter == "b" or letter == "k" or letter == "m") {
                lines = false;
                multiplier = letter;
            } else if (letter == "l") {
                lines = true;
            } else if (letter == "q") {
                headers = HEADERS_NEVER;
            } else if (letter == "v") {
                headers = HEADERS_ALWAYS;
            } else if (letter == "z") {
                zero = true;
            } else {
                return Err(usage_error(i"invalid trailing option -- {$ letter $}"));
            }
            k += 1;
        }
        let parsed = parse_count(number + multiplier, lines)?;
        count = parsed.value;
        count_bytes = !lines;
        i = 1;
    }

    # Pass 2, getopt_long over the rest. Each argument is an operand, `--`,
    # a long option or a cluster of short letters; -c/-n set `has_value`
    # and their value is parsed once the argument has been taken apart.
    while (i < argv.len() and !help and !version) {
        let arg = argv[i];
        i += 1;
        if (only_operands or arg == "-" or !arg.startsWith("-")) {
            operands.push(arg);
            continue;
        }
        if (arg == "--") {
            only_operands = true;
            continue;
        }

        # The option letter or name, and its value for -c/-n.
        var option = "";
        var value = "";
        var has_value = false;
        if (arg.startsWith("--")) {
            let body = arg.slice(2);
            let eq = body.index_of("=");
            let given = if (eq >= 0) { body.slice(0, eq) } else { body };
            let name = match match_long(given, arg, long_names()) {
                Ok(found) => found,
                Err(msg) => {
                    return Err(usage_error(msg));
                },
            };
            if (name == "bytes" or name == "lines") {
                if (eq >= 0) {
                    value = body.slice(eq + 1);
                } else if (i < argv.len()) {
                    value = argv[i];
                    i += 1;
                } else {
                    return Err(usage_error(i"option '--{$ name $}' requires an argument"));
                }
                has_value = true;
                option = if (name == "bytes") { "c" } else { "n" };
            } else if (eq >= 0) {
                return Err(usage_error(i"option '--{$ name $}' doesn't allow an argument"));
            } else if (name == "quiet" or name == "silent") {
                headers = HEADERS_NEVER;
            } else if (name == "verbose") {
                headers = HEADERS_ALWAYS;
            } else if (name == "zero-terminated") {
                zero = true;
            } else if (name == "help") {
                help = true;
            } else {
                version = true;
            }
        } else {
            var letters: list[string] = [];
            for (ch in arg.slice(1)) {
                letters.push(ch);
            }
            var k = 0;
            while (k < letters.len() and !has_value) {
                let letter = letters[k];
                k += 1;
                if (letter == "c" or letter == "n") {
                    option = letter;
                    if (k < letters.len()) {
                        var rest: list[string] = [];
                        while (k < letters.len()) {
                            rest.push(letters[k]);
                            k += 1;
                        }
                        value = rest.join("");
                    } else if (i < argv.len()) {
                        value = argv[i];
                        i += 1;
                    } else {
                        return Err(usage_error(i"option requires an argument -- '{$ letter $}'"));
                    }
                    has_value = true;
                } else if (letter == "q") {
                    headers = HEADERS_NEVER;
                } else if (letter == "v") {
                    headers = HEADERS_ALWAYS;
                } else if (letter == "z") {
                    zero = true;
                } else if (is_digit(letter)) {
                    return Err(usage_error(i"invalid trailing option -- {$ letter $}"));
                } else {
                    return Err(usage_error(i"invalid option -- '{$ letter $}'"));
                }
            }
        }

        # A later -c/-n replaces an earlier one, as in GNU head.
        if (has_value) {
            let parsed = parse_count(value, option == "n")?;
            count = parsed.value;
            count_bytes = option == "c";
            elide = parsed.elide;
        }
    }

    return Ok(Options(
        help = help,
        version = version,
        count = count,
        count_bytes = count_bytes,
        elide = elide,
        headers = headers,
        zero = zero,
        operands = operands,
    ));
}
