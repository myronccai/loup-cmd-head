@mode(host.dual)

# Top level of head: parse the arguments, handle --help and --version, run
# the command and turn the outcome into an exit status (1 for a usage
# error, as GNU head does; a bad number gets no "Try" line).
#
# Runtime: host.dual. Compiled into the native binary build/head by `make
# build`; `loup run source/main.loup` interprets the same code, and the unit
# tests call run() directly.

from appinfo import (APP_NAME, EXIT_OK, EXIT_FAILURE, EXIT_USAGE);
from cli.args import (parse_args);
from cli.usage import (usage, version_line);
from commands.head import (run_head);

# Parses argv, runs head and returns the exit status.
pub func run(argv: list[string]): int {
    let opts = match parse_args(argv) {
        Ok(parsed) => parsed,
        Err(problem) => {
            printErr(APP_NAME + ": " + problem.message);
            if (problem.try_help) {
                printErr(i"Try '{$ APP_NAME $} --help' for more information.");
            }
            return EXIT_USAGE;
        },
    };

    if (opts.help) {
        println(usage());
        return EXIT_OK;
    }
    if (opts.version) {
        println(version_line());
        return EXIT_OK;
    }

    try {
        return run_head(opts);
    } catch (Exception as e) {
        printErr(i"{$ APP_NAME $}: {$ e.message $}");
        return EXIT_FAILURE;
    }
}
