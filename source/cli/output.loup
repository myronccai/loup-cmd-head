@mode(host.dual)

# Writing bytes to standard output. `print` writes a string's bytes as they
# are, but a Loup string can only be built from whole UTF-8 characters, so
# a slice of bytes that ends inside a character (or binary data) has no
# string form: `bytes.decode()` would replace the broken sequence with
# U+FFFD. Such output goes through C's putchar instead.
#
# Runtime: host.dual. Compiled into the native binary build/head by `make
# build`, which links putchar and fflush from the C library through
# `extern native "c"`. `loup run` and the Stage0 test runner accept the
# declarations but cannot call C: `loup run` stops with "unsupported
# instruction" if print_bytes reaches putchar, and the unit tests only call
# is_utf8.

extern native "c" func putchar(c: int32): int32;
extern native "c" func fflush(stream: int): int32;

# Whether `data` is well-formed UTF-8 (no overlong forms, surrogates or
# code points above U+10FFFF), so that `decode()` returns it unchanged.
pub func is_utf8(data: bytes): bool {
    let n = data.len();
    var i = 0;
    while (i < n) {
        let b = data[i];
        if (b < 0x80) {
            i += 1;
            continue;
        }
        var need = 0;
        var lo = 0x80;
        var hi = 0xBF;
        if (b >= 0xC2 and b <= 0xDF) {
            need = 1;
        } else if (b == 0xE0) {
            need = 2;
            lo = 0xA0;
        } else if (b == 0xED) {
            need = 2;
            hi = 0x9F;
        } else if (b >= 0xE1 and b <= 0xEF) {
            need = 2;
        } else if (b == 0xF0) {
            need = 3;
            lo = 0x90;
        } else if (b == 0xF4) {
            need = 3;
            hi = 0x8F;
        } else if (b >= 0xF1 and b <= 0xF3) {
            need = 3;
        } else {
            return false;
        }
        if (i + need >= n) {
            return false;
        }
        for (k in 1..need + 1) {
            let c = data[i + k];
            if (c < lo or c > hi) {
                return false;
            }
            lo = 0x80;
            hi = 0xBF;
        }
        i += need + 1;
    }
    return true;
}

# Writes `data` to standard output exactly.
pub func print_bytes(data: bytes): void {
    if (is_utf8(data)) {
        print(data.decode());
        return;
    }
    for (i in 0..data.len()) {
        putchar(data[i] as int32);
    }
    # Flush C's buffer (fflush(NULL)) so later prints stay in order.
    fflush(0);
}
